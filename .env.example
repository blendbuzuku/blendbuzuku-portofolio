# Links for the BankFlow project on the portfolio. Set these on your host (or
# copy this file to .env.local). NEXT_PUBLIC_ values are baked in when the site
# is built, so rebuild after changing them.

# Where BankFlow is running. Makes the project title and an "Open live demo"
# button link to it.
NEXT_PUBLIC_BANKFLOW_URL=

# Where its code can be read. Only set this if the repository is public — a
# private repository gives visitors a 404. Adds a "View the source" button.
# Example: https://github.com/blendbuzuku/bankflow
NEXT_PUBLIC_BANKFLOW_SOURCE_URL=
